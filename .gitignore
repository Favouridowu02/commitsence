# Node.js typical ignores
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json-debug-*
.pnp/
.pnp.cjs
.pnp.js
.pnp.loader.mjs

# Runtime data
logs/
*.log
*.log.*
pids/
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Coverage directory used by tools like istanbul
coverage/
.nyc_output/

# Test output
test-output/
mocha-*.json

# Build output
dist/
build/
out/
release/

# TypeScript
*.tsbuildinfo

# Optional npm cache directories
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Environment files
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Parcel/Babel/webpack caches
.cache/
.parcel-cache/
.cache-loader/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Next.js
.next/
.next/cache/

# Nuxt.js
.nuxt/
dist/

# Gatsby
.cache/
public/

# Expo
.expo/
.expo-shared/

# Storybook
.storybook/build/

# Svelte
__sapper__/
.svelte-kit/

# Electron
dist-electron/
release/

# Misc
*.tgz
*.gz
*.zip

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDEs and editors
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.code-workspace

# JetBrains
*.iml
*.iws
.idea/*

# Visual Studio
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln

# Docker
docker-compose.override.yml
docker-compose.*.yml
.env.*.docker

# Native addons
build/Release/

# Optional: ignore local secrets managers
.vault/
secrets.json

